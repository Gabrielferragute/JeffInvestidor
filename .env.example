# ==============================================================================
# JEFF INVESTIDOR - VARIÁVEIS DE AMBIENTE (.env)
# ==============================================================================
# Copie este arquivo para .env e preencha com seus dados:
# cp .env.example .env

# [OBRIGATÓRIO] Token do Bot do Telegram gerado pelo @BotFather
JEFF_TELEGRAM_TOKEN=seu_telegram_bot_token_aqui

# [OBRIGATÓRIO] Seu User ID numérico do Telegram (para restringir o acesso apenas a você)
# Obtenha enviando uma mensagem para @userinfobot no Telegram
JEFF_ALLOWED_USER_ID=123456789

# [OBRIGATÓRIO] Chave de API do Google Gemini (Google AI Studio)
# Obtenha gratuitamente em: https://aistudio.google.com/
JEFF_LLM_API_KEY=sua_gemini_api_key_aqui

# [OPCIONAL] Perfil financeiro do usuário (alternativa ao arquivo perfil.md)
# Útil em deploy na nuvem, onde não há arquivo local. Use \n para quebrar linhas.
# JEFF_USER_PROFILE=User Profile:\n- Age: ...\n- Net Monthly Income: R$ ...

# [OPCIONAL] Porta para o servidor de health check HTTP (padrão: 8080)
# Usado por plataformas de hospedagem (Render, Railway, Fly.io, Heroku)
PORT=8080

# [OPCIONAL] Proxy HTTP/HTTPS (caso execute em rede corporativa restrita)
# HTTPS_PROXY=http://proxy.corporativo.com:8080
